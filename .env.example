# PostgreSQL connection used only by db:migrate and server-side repositories.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventario

# Auth0 Regular Web Application. Keep real values only in .env.local.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=generate-a-64-character-hex-secret
APP_BASE_URL=http://localhost:3000
